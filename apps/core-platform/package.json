{
  "name": "@logistics-decision-intelligence/core-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "db",
    "dist"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.js",
    "grpc:generate": "buf generate ../../packages/grpc-contracts --template buf.gen.yaml",
    "build": "pnpm --filter @logistics-decision-intelligence/integration-events build && pnpm --filter @logistics-decision-intelligence/querying build && pnpm clean && nest build",
    "db:migrate": "node dist/cli/database-migrations.js",
    "db:migrate:dev": "pnpm --filter @logistics-decision-intelligence/background-processing build && pnpm build && pnpm db:migrate",
    "db:codegen": "pgtyped -c pgtyped.config.json",
    "admin:provision": "node dist/cli/provision-tenant-administrator.js",
    "lint": "eslint src --max-warnings 0",
    "start": "node dist/main.js",
    "test": "pnpm --filter @logistics-decision-intelligence/background-processing build && pnpm build && node --test 'dist/**/*.spec.js'",
    "dev": "pnpm --filter @logistics-decision-intelligence/background-processing build && pnpm --filter @logistics-decision-intelligence/integration-events build && pnpm --filter @logistics-decision-intelligence/querying build && nest start",
    "typecheck": "pnpm --filter @logistics-decision-intelligence/integration-events build && pnpm --filter @logistics-decision-intelligence/querying build && tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0",
    "@casl/ability": "^7.0.1",
    "@grpc/grpc-js": "^1.14.4",
    "@logistics-decision-intelligence/background-processing": "workspace:*",
    "@logistics-decision-intelligence/integration-event-contracts": "workspace:*",
    "@logistics-decision-intelligence/integration-events": "workspace:*",
    "@logistics-decision-intelligence/querying": "workspace:*",
    "@logistics-decision-intelligence/validation": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-fastify": "^11.1.28",
    "@pgtyped/runtime": "2.4.2",
    "amqplib": "^2.0.1",
    "argon2": "^0.45.1",
    "jose": "^6.2.9",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@logistics-decision-intelligence/grpc-contracts": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@pgtyped/cli": "2.4.3",
    "@types/amqplib": "^0.10.8",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "json-schema-to-ts": "^3.1.1",
    "typescript": "^5.9.3"
  }
}
