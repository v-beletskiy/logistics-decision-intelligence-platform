NODE_ENV=development
PROCESS_ROLES=api,outbox-publisher
HOST=0.0.0.0
PORT=3000

POSTGRES_DB=logistics_decision_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_POOL_MAX=10

RABBITMQ_USER=logistics
RABBITMQ_PASSWORD=logistics
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672
RABBITMQ_RECONNECT_DELAY_MS=1000
RABBITMQ_RETRY_BASE_DELAY_MS=1000
RABBITMQ_MAX_DELIVERY_ATTEMPTS=5

OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_BATCHES_PER_DRAIN=10
OUTBOX_PROCESSING_LEASE_MS=300000
