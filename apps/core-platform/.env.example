NODE_ENV=development
PROCESS_ROLE=api
HOST=0.0.0.0
PORT=3000

GRPC_HOST=0.0.0.0
GRPC_PORT=50051

POSTGRES_DB=logistics_decision_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
DATABASE_POOL_MAX=10

JSON_SCHEMA_BASE_URI=https://schemas.logistics-decision-intelligence.com/core-platform/configuration/app-config/v1

JWT_ISSUER=logistics-decision-intelligence
JWT_AUDIENCE=core-platform
JWT_ACCESS_TOKEN_TTL_SECONDS=900
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

RABBITMQ_USER=logistics
RABBITMQ_PASSWORD=logistics
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@rabbitmq:5672
RABBITMQ_RECONNECT_DELAY_MS=1000
RABBITMQ_RETRY_BASE_DELAY_MS=1000
RABBITMQ_MAX_DELIVERY_ATTEMPTS=5
RABBITMQ_MAX_INCOMING_MESSAGE_BYTES=1048576
RABBITMQ_MAX_OUTGOING_MESSAGE_BYTES=1048576

OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_BATCHES_PER_DRAIN=10
OUTBOX_PROCESSING_LEASE_MS=300000

VROOM_URL=http://vroom:3000
VROOM_PORT=3001
OSRM_URL=http://osrm:5000
OSRM_PORT=5000

OPTIMIZATION_WORKER_PREFETCH=2
