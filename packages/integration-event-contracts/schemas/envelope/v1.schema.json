{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:logistics-decision-intelligence:integration-event-envelope:v1",
  "title": "IntegrationEventEnvelopeV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "specversion": { "const": "1.0" },
    "id": { "type": "string", "format": "uuid" },
    "source": { "type": "string", "format": "uri-reference", "minLength": 1 },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+\\.v[1-9][0-9]*$"
    },
    "subject": { "type": "string", "minLength": 1 },
    "time": { "type": "string", "format": "date-time" },
    "dataschema": { "type": "string", "minLength": 1 },
    "tenantid": { "type": "string", "format": "uuid" },
    "data": { "type": "object" }
  },
  "required": [
    "specversion",
    "id",
    "source",
    "type",
    "subject",
    "time",
    "dataschema",
    "tenantid",
    "data"
  ]
}
