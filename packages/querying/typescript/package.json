{
  "name": "@logistics-decision-intelligence/querying",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Database-neutral TypeScript primitives for application queries.",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../../scripts/clean-package-dist.js dist && tsc -p tsconfig.json",
    "lint": "tsc --noEmit",
    "test": "node --test 'dist/**/*.spec.js'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^5.9.3"
  }
}
